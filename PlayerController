using UnityEngine;

[RequireComponent(typeof(CharacterController))]
public class PlayerController : MonoBehaviour
{
    [Header("Di chuyển")]
    public float moveSpeed = 6f;
    public float rotateSpeed = 720f;
    public float jumpHeight = 1.5f;
    public float gravity = -20f;

    [Header("Máu")]
    public int maxHealth = 100;

    [Header("Tấn công")]
    public int attackDamage = 25;
    public float attackRange = 1.5f;   // khoảng cách đòn đánh phía trước
    public float attackRadius = 1.2f;  // bán kính vùng trúng đòn
    public float attackCooldown = 0.5f;
    public LayerMask enemyLayer;       // chọn Layer "Enemy"

    CharacterController cc;
    Vector3 velocity;
    int currentHealth;
    float nextAttackTime;
    bool dead;

    void Start()
    {
        cc = GetComponent<CharacterController>();
        currentHealth = maxHealth;
        GameManager.Instance.UpdateHealth(currentHealth, maxHealth);
    }

    void Update()
    {
        if (dead) return;
        Move();
        if ((Input.GetMouseButtonDown(0) || Input.GetKeyDown(KeyCode.J)) && Time.time >= nextAttackTime)
        {
            nextAttackTime = Time.time + attackCooldown;
            Attack();
        }
    }

    void Move()
    {
        float h = Input.GetAxisRaw("Horizontal");
        float v = Input.GetAxisRaw("Vertical");
        Vector3 dir = new Vector3(h, 0, v).normalized;

        if (dir.magnitude > 0.1f)
        {
            Quaternion targetRot = Quaternion.LookRotation(dir);
            transform.rotation = Quaternion.RotateTowards(transform.rotation, targetRot, rotateSpeed * Time.deltaTime);
            cc.Move(dir * moveSpeed * Time.deltaTime);
        }

        if (cc.isGrounded && velocity.y < 0) velocity.y = -2f;
        if (cc.isGrounded && Input.GetButtonDown("Jump"))
            velocity.y = Mathf.Sqrt(jumpHeight * -2f * gravity);

        velocity.y += gravity * Time.deltaTime;
        cc.Move(velocity * Time.deltaTime);
    }

    void Attack()
    {
        Vector3 center = transform.position + Vector3.up + transform.forward * attackRange;
        Collider[] hits = Physics.OverlapSphere(center, attackRadius, enemyLayer);
        foreach (var hit in hits)
        {
            Enemy e = hit.GetComponentInParent<Enemy>();
            if (e != null) e.TakeDamage(attackDamage);
        }
    }

    public void TakeDamage(int dmg)
    {
        if (dead) return;
        currentHealth = Mathf.Max(0, currentHealth - dmg);
        GameManager.Instance.UpdateHealth(currentHealth, maxHealth);
        if (currentHealth <= 0)
        {
            dead = true;
            GameManager.Instance.GameOver();
        }
    }

    void OnDrawGizmosSelected()
    {
        Gizmos.color = Color.red;
        Gizmos.DrawWireSphere(transform.position + Vector3.up + transform.forward * attackRange, attackRadius);
    }
}
